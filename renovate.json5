// renovate.json5 - Mender dependency update configuration for integration
// See Documentation/dependency-updates.md in mender-qa for the process.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "github>mendersoftware/mendertesting//renovate/common.json5"
  ],

  // config:recommended also ignores tests/, which hides tests/requirements-python.
  "ignorePaths": ["**/node_modules/**", "**/vendor/**"],

  // python-requirements.txt is pip-compile output: bump the .in and recompile it.
  "pip-compile": {
    "managerFilePatterns": ["/(^|/)python-requirements\\.txt$/"]
  },
  // pip-compile owns these, so pip_requirements must not bump them as well.
  "pip_requirements": {
    "ignorePaths": ["tests/requirements-python/**"]
  },

  // Only rebase open PRs when they actually conflict. Rebasing every time the
  // base branch moves restarts a pipeline for every open PR on each merge.
  "rebaseWhen": "conflicted",

  "baseBranchPatterns": ["master"],

  // Security PRs automerge when CI is green.
  "vulnerabilityAlerts": {
    "automerge": true
  },

  // MENDER_ARTIFACT_VERSION is pinned in two places in this repo.
  "customManagers": [
    // .gitlab-ci.yml, as a variable block with value:
    {
      "customType": "regex",
      "managerFilePatterns": ["/.gitlab-ci.yml/"],
      "matchStrings": [
        "MENDER_ARTIFACT_VERSION:[\\s\\S]*?value:\\s*[\"']?(?<currentValue>[\\d\\.]+)[\"']?"
      ],
      "depNameTemplate": "mendersoftware/mender-artifact",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    // .env, as a plain assignment
    {
      "customType": "regex",
      "managerFilePatterns": ["/.env/"],
      "matchStrings": [
        "MENDER_ARTIFACT_VERSION=(?<currentValue>[\\d\\.]+)"
      ],
      "depNameTemplate": "mendersoftware/mender-artifact",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],

  "packageRules": [
    // Python: one PR for tests/requirements-python and extra/requirements.txt.
    {
      "matchManagers": ["pip_requirements", "pip-compile"],
      "groupName": "python-dependencies",
      "groupSlug": "python-dependencies"
    },

    // Group all docker-compose files into one PR. Only literal
    // image tags are tracked - the ${MENDER_SERVER_*} ones are release tooling's job.
    {
      "matchManagers": ["docker-compose"],
      "groupName": "docker-compose",
      "groupSlug": "docker-compose"
    },

    // extra/gitdm/gitdm is a third-party submodule, don't bump it.
    {
      "matchManagers": ["git-submodules"],
      "enabled": false
    },

    // No major bumps on the maintenance branch - that needs a backport decision.
    {
      "matchBaseBranches": ["/^\\d+\\.\\d+\\.x$/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
