# Tag for all mender-server images (OS and Enterprise).
#
# Deliberately do NOT set MENDER_IMAGE_REGISTRY or MENDER_IMAGE_REPOSITORY here:
# mender-server's base and enterprise compose files reuse those same two
# variables with different defaults (docker.io/mendersoftware vs
# registry.mender.io/mender-server-enterprise), so setting either one globally
# breaks the other flavour.
MENDER_IMAGE_TAG=main

# mongod 8.0 requires AVX; pin lower for runners that lack it.
MONGO_VERSION=7.0

MENDER_CLIENT_REGISTRY=docker.io
MENDER_CLIENT_ENTERPRISE_REGISTRY=registry.mender.io
MENDER_CLIENT_REPOSITORY=mendersoftware

MENDER_CLIENT_DOCKER_ADDONS_IMAGE=mender-client-docker-addons
MENDER_CLIENT_DOCKER_ADDONS_TAG=client-main

MENDER_CLIENT_QEMU_IMAGE=mender-client-qemu
MENDER_CLIENT_QEMU_TAG=client-main

MENDER_CLIENT_QEMU_ROFS_IMAGE=mender-client-qemu-rofs
MENDER_CLIENT_QEMU_ROFS_TAG=client-main

MENDER_MONITOR_QEMU_COMMERCIAL_IMAGE=mender-monitor-qemu-commercial
MENDER_MONITOR_QEMU_COMMERCIAL_TAG=client-main

MENDER_QEMU_ROFS_COMMERCIAL_IMAGE=mender-qemu-rofs-commercial
MENDER_QEMU_ROFS_COMMERCIAL_TAG=client-main

MENDER_CLIENT_QEMU_EXTENDED_IMAGE=mender-client-qemu-extended
MENDER_CLIENT_QEMU_EXTENDED_TAG=client-main

# Artifacts from mender-gateway
MENDER_GATEWAY_IMAGE=mender-gateway
MENDER_GATEWAY_REGISTRY=registry.mender.io
MENDER_GATEWAY_REPOSITORY=mendersoftware
MENDER_GATEWAY_TAG=master

MENDER_ARTIFACT_VERSION=4.4.1
MENDER_CONTAINER_MODULES_VERSION=main

# Version of the Mender Client "bundle"
MENDER_CLIENT_VERSION=main
